{
  "name": "app-aj-att",
  "version": "1.0.7",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "concurrently -n NEXT,ELECTRON -c cyan,yellow \"npm run dev:webpack\" \"wait-on http://127.0.0.1:3000 && ELECTRON_DEV_SESSION=1 electron .\"",
    "electron:dev:devtools": "concurrently -n NEXT,ELECTRON -c cyan,yellow \"npm run dev:webpack\" \"wait-on http://127.0.0.1:3000 && ELECTRON_DEV_SESSION=1 ELECTRON_DEV_TOOLS=true electron .\"",
    "electron:dev:network": "concurrently -n NEXT,ELECTRON -c cyan,yellow \"next dev --hostname 0.0.0.0\" \"wait-on http://127.0.0.1:3000 && ELECTRON_DEV_SESSION=1 ELECTRON_TEST_URL=http://192.168.0.18:3000 ELECTRON_DEV_TOOLS=true electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win --x64",
    "electron:start:static": "npm run build && ELECTRON_USE_STATIC=1 electron ."
  },
  "dependencies": {
    "@hookform/resolvers": "^4",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.6",
    "@tanstack/react-query": "^5",
    "autoprefixer": "10.4.20",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4",
    "es-toolkit": "^1",
    "framer-motion": "^11",
    "lucide-react": "^0.469.0",
    "next": "15.1.0",
    "next-themes": "^0.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7",
    "react-use": "^17",
    "server-only": "0.0.1",
    "ts-pattern": "^5",
    "zod": "^3",
    "zustand": "^4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "postcss": "^8",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  }
}
